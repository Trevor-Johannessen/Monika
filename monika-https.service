[Unit]
Description=Just Monika (HTTPS dashboard)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/portal/tls/portal.crt
ConditionPathExists=/var/lib/portal/tls/portal.key

[Service]
User=tjohannessen
WorkingDirectory=/usr/local/bin/monika
Environment=MONIKA_PORT=3334
Environment=MONIKA_USE_TLS=1
Environment=MONIKA_TLS_CERT=/var/lib/portal/tls/portal.crt
Environment=MONIKA_TLS_KEY=/var/lib/portal/tls/portal.key
ExecStart=/usr/local/bin/monika/start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
